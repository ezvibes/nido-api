# Minimal local API environment.
# Copy to `.env` for day-to-day local development.
# Optional Firebase, GCS, Gemini, and Google Calendar settings live in
# `.env.integrations.example`.

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Local PostgreSQL
# Defaults match docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=nido

# Local schema convenience only. Deployed environments should use migrations.
DB_SYNCHRONIZE=true

# Local auth
# When true and NODE_ENV is not production, API guards accept x-dev-user-* headers.
AUTH_DEV_BYPASS=true

# Admin access for local development.
ADMIN_EMAILS=admin@example.com

# Catalog defaults
CONCERT_GENRE_OPTIONS=Jazz,Bluegrass,Funk,Jam,Reggae,Hip-Hop,Rock,Folk,Salsa,Electronic
CONCERT_SYNC_MAX_EVENTS_PER_JOB=25

# Copy this file to prod.env when production infrastructure is ready.
# Replace every REPLACE_ME value before enabling prod in the workflow dispatch options.

PROJECT_ID=REPLACE_ME_PROD_PROJECT_ID
REGION=us-east1
SERVICE=nido-api
MIGRATION_JOB=nido-api-migrations
REPO=nido
SQL_INSTANCE=REPLACE_ME_PROD_SQL_INSTANCE
FIREBASE_PROJECT_ID=REPLACE_ME_PROD_FIREBASE_PROJECT_ID
FIREBASE_HOSTING_SITE=REPLACE_ME_PROD_FIREBASE_HOSTING_SITE
RUNTIME_SERVICE_ACCOUNT=nido-api-runtime@REPLACE_ME_PROD_PROJECT_ID.iam.gserviceaccount.com
VPC_NETWORK=default
VPC_SUBNET=default
VPC_EGRESS=private-ranges-only

CLOUD_RUN_MEMORY=1Gi
CLOUD_RUN_CPU=1
CLOUD_RUN_CONCURRENCY=80
CLOUD_RUN_TIMEOUT=300
CLOUD_RUN_MIN_INSTANCES=1
CLOUD_RUN_MAX_INSTANCES=20

RUN_MIGRATIONS=true
DB_MIGRATIONS_RUN=false
DB_MIGRATION_TRANSACTION_MODE=each
DB_USER=nido_api
DB_NAME=nido

ADMIN_EMAILS=REPLACE_ME_PROD_ADMIN_EMAILS
GCS_INGESTION_BUCKET=REPLACE_ME_PROD_INGESTION_BUCKET
GEMINI_MODEL=gemini-3.6-flash
CONCERT_GENRE_OPTIONS=REPLACE_ME_COMMA_SEPARATED_GENRES
CONCERT_SYNC_GEMINI_ENABLED=false
CONCERT_SYNC_MAX_EVENTS_PER_JOB=25
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=REPLACE_ME_PROD_CALENDAR_SERVICE_ACCOUNT
CORS_ORIGINS=https://REPLACE_ME_PROD_DOMAIN
BEEHIIV_PUBLICATION_ID=pub_83e3968e-2648-46bd-b71b-ac9a35e4bab4

# Pin numeric Secret Manager versions in production for deterministic rollback.
DB_PASSWORD_SECRET=REPLACE_ME_PROD_DB_PASSWORD_SECRET:REPLACE_ME_NUMERIC_VERSION
FIREBASE_PRIVATE_KEY_SECRET=REPLACE_ME_PROD_FIREBASE_PRIVATE_KEY_SECRET:REPLACE_ME_NUMERIC_VERSION
GEMINI_API_KEY_SECRET=REPLACE_ME_PROD_GEMINI_API_KEY_SECRET:REPLACE_ME_NUMERIC_VERSION
GOOGLE_CALENDAR_PRIVATE_KEY_SECRET=REPLACE_ME_PROD_GOOGLE_CALENDAR_PRIVATE_KEY_SECRET:REPLACE_ME_NUMERIC_VERSION
INTERNAL_SCHEDULER_SECRET_NAME=nido-scheduler-secret:latest
BEEHIIV_API_KEY_SECRET=nido-beehiiv-api-key:latest

# Cloud Tasks & Extraction Worker Pipeline
ENABLE_WORKER_PIPELINE=true
INGESTION_ASYNC_DISPATCH_ENABLED=true
WORKER_SERVICE=nido-ingestion-worker
WORKER_RUNTIME_SERVICE_ACCOUNT=nido-api-runtime@REPLACE_ME_PROD_PROJECT_ID.iam.gserviceaccount.com
WORKER_CLOUD_RUN_MEMORY=2Gi
WORKER_CLOUD_RUN_CPU=2
WORKER_CLOUD_RUN_CONCURRENCY=5
WORKER_CLOUD_RUN_TIMEOUT=600
WORKER_CLOUD_RUN_MIN_INSTANCES=0
WORKER_CLOUD_RUN_MAX_INSTANCES=5
CLOUD_TASKS_QUEUE_NAME=ingestion-worker-queue
CLOUD_TASKS_QUEUE_LOCATION=us-east1
CLOUD_TASKS_QUEUE_PATH=projects/REPLACE_ME_PROD_PROJECT_ID/locations/us-east1/queues/ingestion-worker-queue
CLOUD_TASKS_DISPATCH_RATE=5
CLOUD_TASKS_MAX_CONCURRENCY=5
CLOUD_TASKS_MAX_ATTEMPTS=5
CLOUD_TASKS_MIN_BACKOFF=1s
CLOUD_TASKS_MAX_BACKOFF=300s
CLOUD_TASKS_MAX_RETRY_DURATION=3600s
CLOUD_TASKS_MAX_DOUBLINGS=5
CLOUD_TASKS_INVOKER_SA=cloud-tasks-invoker@REPLACE_ME_PROD_PROJECT_ID.iam.gserviceaccount.com
INGESTION_WORKER_URL=https://nido-ingestion-worker-REPLACE_ME.us-east1.run.app/internal/ingestion/process-job
INGESTION_WORKER_AUDIENCE=https://nido-ingestion-worker-REPLACE_ME.us-east1.run.app

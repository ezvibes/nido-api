{
  "hosting": {
    "public": "client/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "run": {
          "serviceId": "nido-api",
          "region": "us-east1"
        }
      },
      {
        "source": "/sitemap-index.xml",
        "run": {
          "serviceId": "nido-api",
          "region": "us-east1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

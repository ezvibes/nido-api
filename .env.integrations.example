# Optional local integration environment.
# Copy selected keys into `.env` only when testing that integration.
# Do not commit real private keys, service account JSON, API keys, tokens, or
# non-local database passwords.

# Firebase Admin SDK
# Sensitive: FIREBASE_PRIVATE_KEY.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Cloud Storage image uploads
# Sensitive: GCP_PRIVATE_KEY and GCP_SERVICE_ACCOUNT_JSON.
# GCP_SERVICE_ACCOUNT_PATH points to a local credential file and should stay local.
GCS_INGESTION_BUCKET=
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_SERVICE_ACCOUNT_PATH=
GCP_SERVICE_ACCOUNT_JSON=

# Gemini newsletter and extraction
# Sensitive: GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CONCERT_SYNC_GEMINI_ENABLED=false

# Concert sync extraction policy
CONCERT_SYNC_ALLOWED_GENRES=Hip Hop,Latin,Metal,Electronic,Jazz,Country,R&B,Indie,Rock,Pop,Live
CONCERT_SYNC_MIN_CONFIDENCE=0.6
CONCERT_SYNC_REQUIRE_VENUE=true
CONCERT_SYNC_REQUIRE_ARTIST=true
CONCERT_SYNC_MAX_DESCRIPTION_LENGTH=1200

# Google Calendar sync
# Sensitive: GOOGLE_CALENDAR_SERVICE_ACCOUNT_PRIVATE_KEY,
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON, and GOOGLE_CALENDAR_ACCESS_TOKEN.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Scheduled sync worker
# Usually off for local development unless intentionally testing scheduled sync.
CONCERT_SYNC_SCHEDULER_ENABLED=false
CONCERT_SYNC_SCHEDULER_POLL_MS=3600000
